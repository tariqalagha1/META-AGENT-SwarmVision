{
  "name": "@swarmvision/replay-service",
  "version": "1.0.0",
  "description": "SwarmVision event persistence, replay storage, and timeline scrubbing service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "ts-node-dev --respawn src/index.ts",
    "test": "jest --runInBand",
    "db:migrate": "ts-node src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "better-sqlite3": "^9.6.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.12",
    "@types/better-sqlite3": "^7.6.10",
    "@types/uuid": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.2.0"
  }
}
