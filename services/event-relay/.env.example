# SwarmVision FastAPI backend WebSocket base URL
BACKEND_WS_URL=ws://localhost:8012

# UE5 Pixel Streaming signalling server URL (data channel endpoint)
UE5_WS_URL=ws://localhost:8888

# Reconnect interval in ms when a backend channel drops
RECONNECT_INTERVAL_MS=3000

# How long to buffer events if UE5 is not yet connected (ms)
UE5_BUFFER_TTL_MS=10000

# Log level: debug | info | warn | error
LOG_LEVEL=info
